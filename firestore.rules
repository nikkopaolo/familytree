rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipId(uid, clanId) {
      return uid + '_' + clanId;
    }

    function isMember(clanId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(membershipId(request.auth.uid, clanId)));
    }

    function isAdmin(clanId) {
      return signedIn()
        && get(/databases/$(database)/documents/memberships/$(membershipId(request.auth.uid, clanId))).data.role == 'admin';
    }

    function clanIsPublic(clanId) {
      return get(/databases/$(database)/documents/clans/$(clanId)).data.isPublic == true;
    }

    match /clans/{clanId} {
      allow read: if resource.data.isPublic == true || isMember(clanId);
      allow create: if signedIn();
      allow update, delete: if isAdmin(clanId);

      match /persons/{personId} {
        allow read: if clanIsPublic(clanId) || isMember(clanId);
        allow write: if isAdmin(clanId);
      }

      match /relationships/{relationshipId} {
        allow read: if clanIsPublic(clanId) || isMember(clanId);
        allow write: if isAdmin(clanId);
      }

      match /positions/{personId} {
        allow read: if clanIsPublic(clanId) || isMember(clanId);
        allow write: if isMember(clanId);
      }

      match /changeEvents/{eventId} {
        allow read: if isMember(clanId);
        allow create: if isMember(clanId);
        allow update, delete: if isAdmin(clanId);
      }

      match /suggestions/{suggestionId} {
        allow read: if isMember(clanId);
        allow create: if signedIn();
        allow update, delete: if isAdmin(clanId);
      }
    }

    match /memberships/{membershipDoc} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /branchOwners/{ownerId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
