# Firebase Web (Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Deployed site URL (magic-link sign-in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server / migration (service account JSON path — never commit this file)
GOOGLE_APPLICATION_CREDENTIALS=
# Or inline JSON for Vercel/Firebase App Hosting env (optional)
FIREBASE_SERVICE_ACCOUNT_JSON=

SUPER_ADMIN_EMAILS=your-email@gmail.com

# One-time Postgres restore (scripts only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/famtree
